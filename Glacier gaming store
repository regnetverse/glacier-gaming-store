<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Glacier Gaming Store</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: #0b0f19;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px 15px;
        }
        header {
            text-align: center;
            margin-bottom: 25px;
        }
        header h1 {
            color: #38bdf8;
            font-size: 28px;
            letter-spacing: 1px;
        }
        header p { color: #94a3b8; font-size: 14px; margin-top: 4px; }

        /* Product Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }
        .card {
            background: #1e293b;
            border-radius: 12px;
            padding: 15px;
            border: 1px solid #334155;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            text-align: center;
        }
        .card-emoji { font-size: 40px; margin-bottom: 10px; }
        .card h3 { font-size: 16px; margin-bottom: 5px; color: #e2e8f0; }
        .card .price { color: #22c55e; font-weight: bold; font-size: 18px; margin-bottom: 10px; }
        .add-btn {
            background: #3b82f6;
            color: white;
            border: none;
            padding: 8px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
        }

        /* Cart Section */
        .cart-section {
            background: #1e293b;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #38bdf8;
        }
        .cart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #334155;
            padding-bottom: 10px;
            margin-bottom: 15px;
        }
        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            font-size: 14px;
        }
        /* BRIGHT CROSS BUTTON STYLING */
        .remove-btn {
            background: #ff4d4d;
            color: #ffffff;
            border: 1px solid #ff9999;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 0 8px rgba(255, 77, 77, 0.6);
        }
        .total-box {
            margin-top: 15px;
            padding-top: 10px;
            border-top: 1px dashed #475569;
            display: flex;
            justify-content: space-between;
            font-weight: bold;
            font-size: 18px;
            color: #38bdf8;
        }
        .checkout-btn {
            width: 100%;
            background: #22c55e;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            margin-top: 15px;
        }
    </style>
</head>
<body>

    <header>
        <h1>GLACIER GAMING ⚡</h1>
        <p>Premium Gear & Tech Store</p>
    </header>

    <div class="products-grid" id="productGrid"></div>

    <div class="cart-section">
        <div class="cart-header">
            <h2>Your Cart 🛒</h2>
            <span id="cartCount" style="background:#38bdf8; color:#0f172a; padding:2px 8px; border-radius:12px; font-weight:bold; font-size:12px;">0 Items</span>
        </div>

        <div id="cartList"></div>

        <div class="total-box">
            <span>Total:</span>
            <span id="totalPrice">₹0</span>
        </div>

        <button class="checkout-btn" onclick="checkout()">Buy Now 🚀</button>
    </div>

    <script>
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(freq) {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
            gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.1);
            osc.connect(gain); gain.connect(audioCtx.destination);
            osc.start(); osc.stop(audioCtx.currentTime + 0.1);
        }

        const products = [
            { id: 1, name: "RGB Headset", price: 1499, icon: "🎧" },
            { id: 2, name: "Claw Sleeves", price: 199, icon: "🧤" },
            { id: 3, name: "Pro Controller", price: 2499, icon: "🎮" },
            { id: 4, name: "Phone Cooler", price: 899, icon: "❄️" }
        ];

        let cart = JSON.parse(localStorage.getItem("glacierStoreCart")) || [];

        function renderProducts() {
            const grid = document.getElementById("productGrid");
            grid.innerHTML = "";
            products.forEach(p => {
                grid.innerHTML += `
                    <div class="card">
                        <div class="card-emoji">${p.icon}</div>
                        <h3>${p.name}</h3>
                        <div class="price">₹${p.price}</div>
                        <button class="add-btn" onclick="addToCart(${p.id})">Add to Cart ➕</button>
                    </div>
                `;
            });
        }

        function addToCart(id) {
            playSound(800);
            const product = products.find(p => p.id === id);
            cart.push(product);
            saveAndRenderCart();
        }

        function removeFromCart(index) {
            playSound(400);
            cart.splice(index, 1);
            saveAndRenderCart();
        }

        function saveAndRenderCart() {
            localStorage.setItem("glacierStoreCart", JSON.stringify(cart));
            const list = document.getElementById("cartList");
            list.innerHTML = "";

            if (cart.length === 0) {
                list.innerHTML = `<p style="color: #64748b; text-align:center;">Cart is empty!</p>`;
            } else {
                cart.forEach((item, index) => {
                    list.innerHTML += `
                        <div class="cart-item">
                            <span>${item.icon} ${item.name}</span>
                            <div>
                                <span style="color:#22c55e; margin-right:10px; font-weight:bold;">₹${item.price}</span>
                                <button class="remove-btn" onclick="removeFromCart(${index})">✖</button>
                            </div>
                        </div>
                    `;
                });
            }

            const total = cart.reduce((sum, item) => sum + item.price, 0);
            document.getElementById("totalPrice").innerText = "₹" + total;
            document.getElementById("cartCount").innerText = cart.length + " Items";
        }

        function checkout() {
            if (cart.length === 0) {
                alert("Pehle cart mein items add toh karo! 😉");
            } else {
                playSound(1000);
                alert("🎉 Order Placed Successfully!");
                cart = [];
                saveAndRenderCart();
            }
        }

        renderProducts();
        saveAndRenderCart();
    </script>

</body>
</html>

